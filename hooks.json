{
  "plugin-switcher": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "node auto-switch.cjs pre-invocation",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node auto-switch.cjs pre-tool",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
